# -*- mode: ruby -*-
# vi: set ft=ruby :

Vagrant.configure("2") do |config|
  # We use a stable, minimal enterprise Linux base image
  config.vm.box = "bento/rockylinux-9"

  # 1. Control Plane Node
  config.vm.define "control" do |control|
    control.vm.hostname = "control.lab"
    control.vm.network "private_network", ip: "192.168.56.10"
    control.vm.provider "virtualbox" do |vb|
      vb.gui = true
      vb.name = "lab-control"
      vb.memory = "2048"
      vb.cpus = 2
      vb.customize ["modifyvm", :id, "--groups", "/AutomatedInfraLab"]
    end
  end

  # 2. Application Server Node
  config.vm.define "app" do |app|
    app.vm.hostname = "app-01.lab"
    app.vm.network "private_network", ip: "192.168.56.11"
    app.vm.provider "virtualbox" do |vb|
      vb.name = "lab-app-01"
      vb.memory = "1024"
      vb.cpus = 1
      vb.customize ["modifyvm", :id, "--groups", "/AutomatedInfraLab"]
    end
  end

  # 3. Database Server Node
  config.vm.define "db" do |db|
    db.vm.hostname = "db-01.lab"
    db.vm.network "private_network", ip: "192.168.56.12"
    db.vm.provider "virtualbox" do |vb|
      vb.name = "lab-db-01"
      vb.memory = "2048"
      vb.cpus = 1
      vb.customize ["modifyvm", :id, "--groups", "/AutomatedInfraLab"]
    end
  end
end